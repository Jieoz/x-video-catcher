<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No permissions are declared, deliberately.

      All work happens inside X's process, so downloads run under X's own INTERNET permission and
      files are written through MediaStore, which needs no permission for media a caller creates.
      Declaring INTERNET or WRITE_EXTERNAL_STORAGE here would grant this APK capabilities it never
      exercises, since it has no runnable component of its own.
    -->

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_save"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!--
          There is no activity and no service. The APK is a payload for LSPosed to load into X,
          nothing more: tapping its launcher icon would have nothing to show, so no launcher entry
          is declared either.
        -->

        <!-- Read by LSPosed to decide whether to load this APK at all. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposeddescription"
            android:value="Adds a download entry to X's share sheet" />

        <!--
          Minimum Xposed API this module needs. 82 is the level that introduced the hook APIs used
          here; LSPosed reports 93+, so this is a floor rather than a target.
        -->
        <meta-data
            android:name="xposedminversion"
            android:value="82" />

        <!--
          Scope hint: LSPosed pre-selects X when the module is enabled, so the user does not have
          to find the right app in a list of everything installed.
        -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

    </application>

</manifest>
